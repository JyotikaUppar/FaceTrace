pipeline {
    agent any

    environment {
        DOCKER_REGISTRY = 'docker.io'
        APP_NAME = 'facetrace'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                checkout scm
            }
        }

        stage('Lint & Syntax Checks') {
            steps {
                echo 'Running syntax verification across microservices...'
                sh '''
                    node -c services/person-service/index.js
                    node -c services/location-service/index.js
                    node -c services/notification-service/index.js
                    python3 -m py_compile face_recognition/apicall.py
                    python3 -m py_compile face_recognition/imagesapi.py
                    python3 -m py_compile face_recognition/main.py
                '''
            }
        }

        stage('Docker Compose Validation') {
            steps {
                echo 'Validating Docker Compose orchestration configuration...'
                sh 'docker compose config'
            }
        }

        stage('Build Microservices Images') {
            steps {
                echo 'Building Docker container images...'
                sh 'docker compose build --parallel'
            }
        }

        stage('Deploy Microservices Mesh') {
            steps {
                echo 'Starting microservices mesh...'
                sh 'docker compose up -d'
            }
        }
    }

    post {
        always {
            echo 'Pipeline Execution Completed.'
        }
        success {
            echo 'FaceTrace Microservices CI/CD Pipeline Succeeded!'
        }
        failure {
            echo 'FaceTrace Microservices CI/CD Pipeline Failed.'
        }
    }
}
